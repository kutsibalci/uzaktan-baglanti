# Bağımlılıklar (npm install ile gelir)
node_modules/

# Kullanıcı hesapları, cihaz anahtarları, günlük — ASLA repoya girmemeli
data/
# Ev ağı HTTPS anahtarları data/sertifika/ altındadır; yanlışlıkla başka yere kopyalanırsa da girmesin
*-anahtar.pem

# Derlenen yerel programlar: RemoteHelper, Pano, Perde, Ses, Durum, Tepsi (sunucu / tepsi-baslat.bat açılışta derler)
helper/*.exe

# Taşınabilir paket çıktısı (tools\paketle.ps1)
dist/

# Küçük ffmpeg (tools/ffmpeg-derle.sh, Actions'ta derlenir; lib/ffmpeg.js önce bunu kullanır)
/ffmpeg/

# Geçici dosyalar
*.tmp
*.log

# usb-baglan.bat ile indirilen Android platform-tools (adb)
tools/platform-tools/

# Claude Code çalışma klasörü (ajan worktree'leri)
.claude/

# Yalnızca bu bilgisayara özel notlar (Tailscale adresi vb.) ve konuşma notlarının kopyası: açık depoya girmez
CLAUDE.local.md
HAFIZA.md
